# Ren'Py - diretórios gerados
/game/saves/
/game/cache/

# Scripts compilados
/game/**/*.rpyc
/game/**/*.rpymc

# Arquivos temporários gerados pelo Ren'Py
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Logs, erros e arquivos de diagnóstico
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Arquivos gerados pelo Launcher
/dialogue.tab
/dialogue.txt
/strings.json

# Python
__pycache__/
*.py[cod]

# Builds e distribuições
/build/
/dist/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# IDEs e editores
.idea/
.vscode/
